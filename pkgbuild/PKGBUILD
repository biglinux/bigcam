# Maintainer: Bruno Gonçalves <bigbruno@gmail.com>
# Autor: Rafael Ruscher <rruscher@gmail.com>
#        Barnabé di Kartola <barnabedikartola@gmail.com>
pkgname=bigcam
pkgdesc="Universal webcam control center for BigLinux"
depends=(
    # Python runtime
    'python'
    'python-gobject'
    'python-opencv'
    'python-numpy'
    'python-aiohttp'
    'python-qrcode'

    # GTK4 / UI
    'gtk4'
    'libadwaita'

    # GStreamer core + plugins
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'gst-plugins-ugly'
    'gst-plugin-gtk4'
    'gst-plugin-libcamera'
    'gst-libav'

    # Camera backends & virtual camera
    'v4l-utils'
    'v4l2loopback-dkms'
    'linux-headers'
    'gphoto2'
    'libcamera'
    'libcamera-tools'

    # Media / audio
    'ffmpeg'
    'pipewire'
    'pipewire-libcamera'
    'libpulse'

    # Phone / Android / AirPlay
    'scrcpy'
    'android-tools'
    'uxplay'

    # QR / barcode
    # Reading is done by OpenCV: QRCodeDetector for QR, cv2.barcode for the
    # 1-D symbologies.  Neither zbar (Python 2 binding only) nor python-pyzbar
    # (AUR, so it cannot be a dependency of a repo package) is needed.
    'qrencode'

    # Network / security / system
    'avahi'
    'openssl'
    'sudo'
    'polkit'
    'xdg-utils'
    'xdg-user-dirs'
    'psmisc'
    'usbutils'
)
makedepends=('git' 'gettext')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL3')
url="https://github.com/biglinux/$pkgname"
backup=('etc/sudoers.d/bigcam' 'etc/modprobe.d/v4l2loopback.conf')
provides=("$pkgname")
source=("git+${url}.git")
sha256sums=('SKIP')
install=pkgbuild.install

package() {
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}/${pkgname}"
    else
        InternalDir="${srcdir}/${pkgname}"
    fi

    # Recompile the catalogues from locale/*.po rather than trusting the .mo
    # files committed alongside them.  The two drift: a merge that takes an
    # incoming .po but keeps the local .mo leaves strings compiled out, and
    # nothing at review time makes that visible.
    if [ -x "${InternalDir}/build-translations.sh" ]; then
        (cd "${InternalDir}" && ./build-translations.sh)
    fi

    if [ -d "${InternalDir}/usr" ]; then
        cp -r "${InternalDir}/usr" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/etc" ]; then
        cp -r "${InternalDir}/etc" "${pkgdir}/"
    fi

    # /usr/share/locale is a namespace shared by every package on the system.
    # Only the compiled catalogue belongs there, under <lang>/LC_MESSAGES/ and
    # named after the text domain.  A flat pt-BR.po collides with any other
    # package that ships one (it did, with big-gnome-center), and pacman
    # aborts the whole transaction.  Translation sources live in locale/ and
    # are never installed; strip them if one ever slips back in.
    find "${pkgdir}/usr/share/locale" -maxdepth 1 -type f \
        \( -name '*.po' -o -name '*.pot' \) -delete 2>/dev/null || true

    # sudoers files must be 0440 or sudo refuses to parse them
    if [ -f "${pkgdir}/etc/sudoers.d/bigcam" ]; then
        chmod 0440 "${pkgdir}/etc/sudoers.d/bigcam"
    fi

    # The privileged helper is granted NOPASSWD in sudoers.  sudo refuses to
    # run a command that is writable by anyone other than root, and a
    # user-writable helper would be a trivial root escalation.  Enforce
    # root:root 0755 explicitly rather than relying on the source tree.
    helper="${pkgdir}/usr/share/biglinux/bigcam/script/bigcam-v4l2loopback"
    if [ -f "$helper" ]; then
        chown 0:0 "$helper"
        chmod 0755 "$helper"
    fi

    # Remaining scripts only ever run unprivileged.
    for s in "${pkgdir}/usr/share/biglinux/bigcam/script/"*.sh; do
        [ -f "$s" ] && chmod 0755 "$s"
    done
}

check() {
    # Fail the build rather than shipping an unparseable sudoers drop-in.
    if command -v visudo >/dev/null 2>&1; then
        visudo -c -f "${srcdir}/${pkgname}/etc/sudoers.d/bigcam" >/dev/null
    fi
}
